# ==========================================
# Python 字节码与缓存
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ==========================================
# 虚拟环境（仅忽略根目录下虚拟环境，保护 Code/env）
# ==========================================
/.venv/
/venv/
/env/
/ENV/
/conda-env/
!Code/env/
!Code/env/**

# ==========================================
# 深度强化学习与训练日志
# ==========================================
# TensorBoard 事件文件与运行日志（避免协同冲突及体积暴增）
*.tfevents.*
*.log
# 本地临时模型检查点（正式模型建议规范归档或通过Release分发）
*.pt
*.pth
*.ckpt
*.h5

# ==========================================
# LaTeX 论文编译临时辅助文件
# ==========================================
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.xdv
*.toc
*.lof
*.lot
*.bcf
*.run.xml
*.nav
*.snm
*.vrb
*.upa
*.upb

# ==========================================
# IDE、编辑器与操作系统配置文件
# ==========================================
# 个人编辑器个性化路径（如 python.defaultInterpreterPath）
.vscode/*
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# 操作系统临时文件
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
*.tmp

# ==========================================
# 实验过程数据（不入版本库）
# ==========================================
experiments/

# ==========================================
# 本地智能体协作规范（仅加密组本地使用，避免远程冲突）
# ==========================================
AGENTS.md
AGENTS.MD

# ==========================================
# 加密模块本地过程文档与报告
# ==========================================
Code/encry/*.md
Code/encry/**/*.md

# ==========================================
# 论文插图目录本身及其所有下属内容
# ==========================================
Manuscript/figures/
Manuscript/figures/**


